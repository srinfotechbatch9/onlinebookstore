pipeline{
    agent any
    stages{
        
        stage('Clone'){
            
            steps{
                
              git branch: 'feature/2026.10.15', url: 'https://github.com/srinfotechbatch9/onlinebookstore.git'
            }
        }
        stage('Build'){
            
            steps{
                bat 'mvn install'
            }
        }
        stage('Test'){

            steps{

                bat 'mvn test'
            }
        }

        stage('Published Artifcats'){

            steps{

                archiveArtifacts artifacts: 'target/*.war', followSymlinks: false
            }
        }
    }
}
